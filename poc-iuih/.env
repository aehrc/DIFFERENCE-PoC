# ============================================================================
# DIFFERENCE POC — IUIH stack config
# ============================================================================
# PUBLIC endpoints. The browser (frontend) talks to these directly, so they
# MUST be reachable from the end-user's browser and, for the gateway, from the
# other org's browser too. Replace the example.* placeholders for a real deploy.

# Public hostnames. Add BOTH to your machine's /etc/hosts pointing at 127.0.0.1:
#   127.0.0.1  example.iuih.org example.mater.org
SELF_HOST=example.iuih.org
OTHER_HOST=example.mater.org

# Caddy public ports. HTTP_PORT serves plain HTTP and 308-redirects to the
# HTTPS canonical origin on HTTPS_PORT. Distinct per stack so both co-exist.
HTTP_PORT=8080      # http://SELF_HOST:8080 -> redirects to https://SELF_HOST:8443
HTTPS_PORT=8443     # canonical HTTPS origin

# --- This stack's own public URLs (IUIH), canonical HTTPS via the proxy ---
SELF_FRONTEND_URL=https://example.iuih.org:8443
SELF_FHIR_URL=https://example.iuih.org:8443/fhir
SELF_KC_URL=https://example.iuih.org:8443/auth

# --- The OTHER org's public URLs (Mater) — the frontend's SECONDARY server ---
OTHER_FRONTEND_URL=https://example.mater.org:8543
OTHER_FHIR_URL=https://example.mater.org:8543/fhir
OTHER_KC_URL=https://example.mater.org:8543/auth

# --- Extra host ports published for direct debugging (bypass the proxy) ---
FRONTEND_PORT=5173
FHIR_PORT=8081      # FHIR Info Gateway direct
HAPI_PORT=8091      # raw HAPI
KC_PORT=9081        # Keycloak http direct
KCS_PORT=9441       # Keycloak https direct

# --- Keycloak admin ---
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=adminpass

# --- DIFFERENCE POC realm / viewer client (registered by keycloak-init) ---
POC_REALM=DIFFERENCE_POC
CLIENT_ID=difference-poc-viewer
POC_USER=poc
POC_PASS=poc

# --- Legacy realms used by the bundled alvearie/proxy config steps ---
TEST_REALM=test
TEST_USER=testuser
TEST_PASS=testpass
SMART_REALM=test-smart

# --- Optional Smart Forms questionnaire repo ---
FORMS_SERVER_URL=https://smartforms.csiro.au/api/fhir
FORMS_SERVER_TOKEN=
